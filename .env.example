# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Claude API key, from the Anthropic Console. Set a monthly spend limit on it there.
ANTHROPIC_API_KEY=

# Postgres. For the local database in docker-compose.yml, use the user, password and database
# name set there: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=

# Better Auth. The secret is any long random string (for example: openssl rand -base64 32).
# The URL is where the app runs.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in: an OAuth client from the Google Cloud Console, with
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional.
# LINEAGE_MODEL=claude-haiku-5-5        # model used for charts
# LINEAGE_EFFORT=medium                 # low, medium or high
# CHART_REQUESTS_PER_HOUR=10            # new charts per IP per hour
# MB_CONTACT=                           # email or URL sent to MusicBrainz in the User-Agent
